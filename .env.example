# OpenAI Configuration
OPENAI_API_KEY=sk-tu-api-key-de-openai

# WhatsApp Cloud API Configuration (Meta)
META_ACCESS_TOKEN=tu_token_de_acceso_permanente_aqui
PHONE_NUMBER_ID=tu_phone_number_id_aqui
WEBHOOK_VERIFY_TOKEN=blak_webhook_token
META_APP_SECRET=tu_app_secret_aqui
CHATBOT_ENABLED=false
CHATBOT_ACTIVE_FROM=18
CHATBOT_ACTIVE_UNTIL=9
CHATBOT_TIMEZONE=America/Argentina/Buenos_Aires

# Server Configuration
PORT=3000
NODE_ENV=development

# Acceso al dashboard (obligatorio en producción)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_por_una_clave_segura
ADMIN_SESSION_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Optional: Sandbox for testing
SANDBOX_MODE=false
SANDBOX_PHONE_NUMBER=5491137947206

# PostgreSQL. El chatbot usa exclusivamente el schema blak_twilio.
DATABASE_URL=postgresql://usuario:password@localhost:5432/whatsapp_bot
